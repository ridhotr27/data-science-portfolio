# Public host name only; do not include a scheme or path.
DOMAIN=portfolio.example.com
ACME_EMAIL=admin@example.com

# Immutable GHCR tags produced by GitHub Actions. Replace COMMIT_SHA before use.
FRONTEND_IMAGE=ghcr.io/ridhotr27/data-science-portfolio-frontend:COMMIT_SHA
BACKEND_IMAGE=ghcr.io/ridhotr27/data-science-portfolio-backend:COMMIT_SHA

# Exact browser origin allowed by FastAPI CORS.
ALLOWED_ORIGINS=https://portfolio.example.com

# In-memory upload/session controls.
DATASET_TTL_SECONDS=900
MAX_DATASET_SESSIONS=3
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=60

# XGBoost is intentionally disabled in production. The Compose file enforces false.
ENABLE_XGBOOST=false
VITE_ENABLE_XGBOOST=false
